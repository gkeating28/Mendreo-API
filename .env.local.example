# Local development environment template.
# Copy to .env.local and adjust as needed:
#   cp .env.local.example .env.local

# Core Django
GENERAL_SECRET_KEY=dev-insecure-secret-change-me
GENERAL_DEBUG=True
GENERAL_HOST_DOMAIN=localhost,127.0.0.1

# Local PostgreSQL (matches CI: postgres/1234/mendreo)
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=mendreo
DATABASE_USER=postgres
DATABASE_PASSWORD=1234

# Celery runs tasks inline in dev (no Redis worker required)
CELERY_TASK_ALWAYS_EAGER=True
BROKER_URL=memory://

# Hybrid deployment (Vercel + worker) — leave unset for local inline AI
# DEPLOYMENT_TARGET=local
# AI_WORKER_URL=http://127.0.0.1:8000
# INTERNAL_API_SECRET=dev-internal-secret
# AI_WORKER_TIMEOUT=120
# CRON_SECRET=dev-cron-secret

# Optional integrations — leave blank for local dev unless you need them.
# Object storage: Supabase Storage, via its S3-compatible API. Generate S3
# access keys under Project Settings -> Storage -> S3 Access Keys.
# SUPABASE_STORAGE_URL=https://<project_ref>.supabase.co
# SUPABASE_STORAGE_S3_ENDPOINT=https://<project_ref>.storage.supabase.co/storage/v1/s3
# SUPABASE_STORAGE_ACCESS_KEY_ID=
# SUPABASE_STORAGE_SECRET_ACCESS_KEY=
# SUPABASE_STORAGE_REGION=eu-west-1        # must match Storage → S3 region in dashboard
# SUPABASE_STORAGE_BUCKET=                 # public bucket: images/files
# SUPABASE_STORAGE_PRIVATE_BUCKET=         # private bucket: chat logs (PII)
# SUPABASE_ANON_KEY=                       # preferred: public anon key for REST signed uploads
# SUPABASE_SERVICE_ROLE_KEY=               # optional: bypasses RLS (keep secret)
# SENDGRID_API_KEY=
# STRIPE_SECRET_KEY=
# Temporary: skip Stripe paywall (complimentary active subscriptions). Set false once billing works.
# BYPASS_SUBSCRIPTION=true
# GOOGLE_API_KEY=
# GOOGLE_OAUTH2_KEY=
# GOOGLE_OAUTH2_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET_KEY=
# APPLE_TEAM_ID=
# APPLE_CLIENT_ID=
# APPLE_KEY_ID=
# APPLE_KEY_SECRET=
# APPLE_REDIRECT_URI=
# APPLE_SERVICES_ID=
# APPLE_IN_APP_SHARED_SECRET=
# BUNDLE_ID_IOS=
# BUNDLE_ID_ANDROID=
# SURVEY_CODE=
# SURVEY_WEB_APP_URL=
# SURVEY_MOBILE_APP_URL=
# EMAIL_FROM=noreply@example.com

# Alternative: point at Supabase dev DB instead of local Postgres
# SUPABASE_DEV_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
