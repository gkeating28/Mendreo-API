mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash run_dev.sh"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "run_dev.sh"]
build = ["bash", "-c", "python -m venv .venv && .venv/bin/python -m ensurepip --upgrade && .venv/bin/pip install --upgrade pip && .venv/bin/pip install -r requirements.txt && source set_db_env.sh && cd mendreo && ../.venv/bin/python manage.py migrate --noinput && ../.venv/bin/python manage.py collectstatic --noinput"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
