GENERAL_SECRET_KEY = "DCqk2VAwwP9KKWniSsnESeDus_LSVbJZHnL3XrPu6F_4cFl_EhRzJWLVKScPxoSggYUpWDKbLbTAGn3Nn2fjEg"

[workflows]
runButton = "Project"

[[workflows.workflow]]
