{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd mendreo && python manage.py migrate --noinput && python manage.py collectstatic --noinput",
  "env": {
    "PYTHONPATH": "mendreo"
  },
  "functions": {
    "wsgi.py": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/internal/cron/check-subscriptions",
      "schedule": "0 1 * * *"
    }
  ]
}
