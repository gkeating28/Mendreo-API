# Local development environment template.
# Copy to .env.local and adjust as needed:
#   cp .env.local.example .env.local

# Core Django
GENERAL_SECRET_KEY=dev-insecure-secret-change-me
GENERAL_DEBUG=True
GENERAL_HOST_DOMAIN=localhost,127.0.0.1

# Local PostgreSQL (matches CI: postgres/1234/mendreo)
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=mendreo
DATABASE_USER=postgres
DATABASE_PASSWORD=1234

# Celery runs tasks inline in dev (no Redis worker required)
CELERY_TASK_ALWAYS_EAGER=True
BROKER_URL=memory://

# Optional integrations — leave blank for local dev unless you need them.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET_NAME=
# AWS_CLOUD_FRONT_DOMAIN=
# AWS_CLOUD_FRONT_RESIZER_DOMAIN=
# SENDGRID_API_KEY=
# STRIPE_SECRET_KEY=
# GOOGLE_API_KEY=
# GOOGLE_OAUTH2_KEY=
# GOOGLE_OAUTH2_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET_KEY=
# APPLE_TEAM_ID=
# APPLE_CLIENT_ID=
# APPLE_KEY_ID=
# APPLE_KEY_SECRET=
# APPLE_REDIRECT_URI=
# APPLE_SERVICES_ID=
# APPLE_IN_APP_SHARED_SECRET=
# BUNDLE_ID_IOS=
# BUNDLE_ID_ANDROID=
# SURVEY_CODE=
# SURVEY_WEB_APP_URL=
# SURVEY_MOBILE_APP_URL=
# EMAIL_FROM=noreply@example.com

# Alternative: point at Supabase dev DB instead of local Postgres
# SUPABASE_DEV_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
